  sentences:
  - "\uC548\uB155\uD558\uC138\uC694! \uC5EC\uD589\uC790\uB2D8 \uB9CC\uB098\uC11C
    \uBC18\uAC11\uC2B5\uB2C8\uB2E4.\n\uACF3\uACF3\uC5D0 \uACF0\uC774 \uCD9C\uBAB0\uD558\uB2C8
